# YouTube Data API v3 key — Required for video search
# Get it at: https://console.cloud.google.com → Enable "YouTube Data API v3" → Create credentials → API Key
YOUTUBE_API_KEY=

# SerpAPI key — Optional, used for broader web resource search
# Get it at: https://serpapi.com
SERPAPI_KEY=

# OpenAI API key — Optional, for AI-assisted content drafting in standalone mode
OPENAI_API_KEY=
